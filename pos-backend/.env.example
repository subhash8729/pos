# ========================================================
# POS Backend - Production Environment Variables Template
# ========================================================

# Server Port (Cloud platforms like Render/Railway automatically inject PORT)
PORT=5000

# --------------------------------------------------------
# Database Configuration (MySQL)
# --------------------------------------------------------
# Option A: Individual DB credentials (or Railway internal variables)
DB_HOST=43.205.26.72
DB_PORT=3306
DB_NAME=billingsystem
DB_USERNAME=pos
DB_PASSWORD=pos

# Option B: Full JDBC URL (Used by cloud providers like Aiven, TiDB, Clever Cloud)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/pos_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC

# Hibernate DDL Auto (Use 'update' for automatic schema migration in college projects)
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# --------------------------------------------------------
# Security & JWT
# --------------------------------------------------------
# Minimum 32-character / 256-bit secure secret key
JWT_SECRET=asdfghjklpoiuytrewqzxcvbnmlkjhglpouhggfdsawqwertyyuiioplmnbvcxzasdfgh

# CORS: Comma-separated list of allowed frontend origins (or '*' to permit any)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Frontend application base URL for redirects and payment callbacks
FRONTEND_URL=https://your-frontend.vercel.app

# --------------------------------------------------------
# Email Service (Gmail SMTP for OTP / Password Reset)
# --------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-16-char-app-password

# --------------------------------------------------------
# Payment Gateways (Optional for initial startup)
# --------------------------------------------------------
RAZORPAY_KEY=rzp_test_TmykOdjDOKPDGm
RAZORPAY_SECRET=s8vaJ5yV7PluPrkzZtuGdwNH
STRIPE_KEY=STRIPE_SECRET_KEY=your_stripe_secret_key_here
